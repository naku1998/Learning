<Window x:Class="Tray_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tray_WPF"
        mc:Ignorable="d"
        Title="Service Status" Height="350" Width="400">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    
    <StackPanel Margin="20">
        <TextBlock Text="Service Status" FontWeight="Bold" FontSize="18" Margin="0,0,0,10" />

        <!-- Status Indicators -->
        <ItemsControl x:Name="StatusList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse Width="16" Height="16" Fill="{Binding StatusColor}" />
                        <TextBlock Text="{Binding DisplayName}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Service List -->
        <ListView x:Name="ServiceList"  Margin="0,20,0,0" Height="120"  ItemsSource="{Binding serviceDisplayItems}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Service Name" Width="150" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding IsRunning}" />
                    <GridViewColumn Header="Action" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Start"
                                Click="StartServiceButton_Click"
                                Tag="{Binding}"
                                Padding="4,2"
                                FontSize="12"
                                Background="LightGreen"
                                BorderBrush="DarkGreen"
                                Visibility="{Binding Stopped, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>
