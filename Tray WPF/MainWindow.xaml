<Window x:Class="Tray_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tray_WPF"
        mc:Ignorable="d"
        Title="Service Status" Height="350" Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Service Status" FontWeight="Bold" FontSize="18" Margin="0,0,0,10" />

        <!-- Status Indicators -->
        <ItemsControl x:Name="StatusList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Ellipse Width="16" Height="16" Fill="{Binding StatusColor}" />
                        <TextBlock Text="{Binding DisplayName}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Service List -->
        <ListView x:Name="ServiceList" Margin="0,20,0,0" Height="100">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Service Name" Width="200" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding IsRunning}" />
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>
