# Here is the  boiler code for tray app in .Net

Open Visual Studio

Create a new project → WPF App (.NET Framework)

Name it: TrayMonitorApp

# 3 files will be there

✅ App.xaml.cs: Starts the app.

✅ MainWindow.xaml: Your UI window for showing service status.

✅ NotifyIcon: Shows tray icon and handles right-click or double-click actions.

# Create a basic layout to show services:

Step 1: MainWindow.xaml UI
<Window x:Class="TrayMonitorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Status" Height="250" Width="400">
    <Grid>
        <ListView Name="ServiceList" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Service" DisplayMemberBinding="{Binding Name}" Width="200"/>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>

Step 2: MainWindow.xaml.cs Code-Behind

    using System;
    using System.Collections.Generic;
    using System.ServiceProcess;
    using System.Windows;

    namespace Tray_WPF
    {
        public partial class MainWindow : Window
        {
            private readonly string[] serviceNames = { "Service1", "Service2", "Service3" };

            public MainWindow()
            {
                InitializeComponent();
                LoadServiceStatus();
            }

            public void LoadServiceStatus()
            {
                var list = new List<ServiceStatus>();

                foreach (var name in serviceNames)
                {
                    try
                    {
                        using (ServiceController sc = new ServiceController(name))
                        {
                            sc.Refresh();
                            list.Add(new ServiceStatus { Name = name, Status = sc.Status.ToString() });
                        }
                    }
                    catch (Exception ex)
                    {
                        list.Add(new ServiceStatus { Name = name, Status = "Error" });
                    }
                }

                ServiceList.ItemsSource = list;
            }

            public class ServiceStatus
            {
                public string Name { get; set; }
                public string Status { get; set; }
            }
        }
    }



Step 3: App.xaml.cs with Tray Icon

    using System.Drawing;
    using System.Windows;
    using Forms = System.Windows.Forms;

    namespace Tray_WPF
    {

        public partial class App : Application
        {
            // private NotifyIcon trayIcon;
            Forms.NotifyIcon trayIcon = new Forms.NotifyIcon();
            private MainWindow mainWindow;

            protected override void OnStartup(StartupEventArgs e)
            {
                base.OnStartup(e);

                mainWindow = new MainWindow();
                mainWindow.Hide(); // Start hidden

                trayIcon = new Forms.NotifyIcon
                {
                    Icon = new Icon("Res/AB.ico"),
                    Visible = true,
                    Text = "Service Monitor",
                    ContextMenuStrip = new Forms.ContextMenuStrip()
                };

                trayIcon.ContextMenuStrip.Items.Add("Open", null, (s, ev) => ShowMainWindow());
                trayIcon.ContextMenuStrip.Items.Add("Exit", null, (s, ev) => ExitApp());

                trayIcon.DoubleClick += (s, ev) => ShowMainWindow();
            }

            private void ShowMainWindow()
            {
                if (!mainWindow.IsVisible)
                {
                    mainWindow.Show();
                    mainWindow.WindowState = WindowState.Normal;
                }
                else
                {
                    mainWindow.Activate();
                }

                mainWindow.LoadServiceStatus();
            }

            private void ExitApp()
            {
                trayIcon.Visible = false;
                mainWindow.Close();
                Shutdown();
            }
        }
    }


